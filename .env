# Web Landing Page Environment Variables Template
# # Prefix all client-exposed keys with VITE_ or REACT_APP_ based on your bundler

# # ==================== CORE ====================
# API_BASE_URL=https://api.na3eeman.com
# ENVIRONMENT=production

# # ==================== MAPS ====================
# GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# # ==================== FIREBASE ====================
# FIREBASE_API_KEY=your-firebase-api-key
# FIREBASE_AUTH_DOMAIN=your-firebase-auth-domain
